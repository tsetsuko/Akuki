# npm 10.9.8's arborist crashes resolving vitest's peer graph
# ("Cannot read properties of null (reading 'edgesOut')" in #loadPeerSet).
# The crash is in peer resolution for @vitest/browser-playwright and has nothing
# to do with the file: link to the borg fork. Pinned here so `npm ci` on the VPS
# does not need the flag remembered on the command line.
legacy-peer-deps=true
