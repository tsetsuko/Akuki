# secrets
.env

# akuki's memory (local, not shared)
.akuki/
*.db

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# borg fork -- own git repo with `upstream` -> TKasperczyk/borg.
# It CANNOT be merged into this repo without losing the ability to fetch and
# merge Tomek's dev branch, so it lives here as a nested repository instead.
borg/

# Akuki's tenant: borg.db, lancedb, locks, snapshots, experiment copies.
# Changes every turn and gets cp -r'd for M1's three-arm internalization test.
data/

# akuki-connector: installed dependencies and build output. The borg dependency is
# a file: link to the nested fork, so node_modules/borg is a symlink into an
# ignored directory and must never be committed.
connector/node_modules/
connector/dist/

# Development diary vault: observations and the template are tracked. Candidate
# notes are regenerated by `python -m akuki.dziennik` and quote whole Arena
# conversations, so they stay local. Obsidian's per-machine UI state too.
dziennik/kandydaci/
dziennik/.obsidian/workspace*.json
dziennik/.obsidian/cache
dziennik/.obsidian/plugins/
dziennik/.obsidian/themes/
