{
  "hosts": {
    "akuki-vcn": "100.124.237.35",
    "zosia-latitude-7490": "100.73.191.40",
    "oppo-a6-pro-5g": "100.69.4.80"
  },

  "grants": [
    {
      "src": ["zosia-latitude-7490"],
      "dst": ["akuki-vcn"],
      "ip": ["tcp:22", "tcp:5173"]
    },
    {
      "src": ["oppo-a6-pro-5g"],
      "dst": ["akuki-vcn"],
      "ip": ["tcp:5173"]
    }
  ],

  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"]
    }
  ],

  "tests": [
    {
      "src": "zosia-latitude-7490",
      "proto": "tcp",
      "accept": ["akuki-vcn:22", "akuki-vcn:5173"],
      "deny": ["akuki-vcn:7740", "akuki-vcn:11434"]
    },
    {
      "src": "oppo-a6-pro-5g",
      "proto": "tcp",
      "accept": ["akuki-vcn:5173"],
      "deny": ["akuki-vcn:22", "akuki-vcn:7740"]
    }
  ]
}
