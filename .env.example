# Akuki -- local config. Copy to .env (chmod 600). Secrets live in `pass`, NOT here.
#
# Run him like this so the key never touches disk or shell history:
#   ANTHROPIC_API_KEY="$(pass show akuki/anthropic-key)" python -m akuki.chat

# Which model Akuki thinks with.
AKUKI_MODEL=claude-opus-4-8

# Where his transcript lives.
AKUKI_DB=.akuki/akuki.db

# How many past messages of a thread get replayed into each turn.
AKUKI_HISTORY=20

# Your name in the terminal chat -- he treats this person as family.
AKUKI_OWNER=zosia
