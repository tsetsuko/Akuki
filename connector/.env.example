# Copy to .env for a local rehearsal against the fake Arena. .env is gitignored.
#
# THESE ARE NOT THE REAL CREDENTIALS AND MUST NOT BE. The fake Arena is not the
# Arena: the token and the cookie here are nothing more than a shared secret
# between two local processes, so any two matching strings work. Putting the live
# token in this file would buy nothing and spread it further.
#
# Both halves read the same file, which is the point -- credentials that have to
# match cannot drift apart if there is only one copy of them.

AKUKI_ARENA_API_BASE=http://127.0.0.1:7750

# Read by borg's demo server to host this connector in its own process. MUST BE
# ABSOLUTE: the server resolves it against its own working directory, which is
# borg/demo/server, so a path like ../connector/src/plugin.ts becomes
# borg/demo/connector/... and fails with ERR_MODULE_NOT_FOUND.
# EXTRA_CONNECTOR_MODULE=/absolute/path/to/connector/src/plugin.ts
AKUKI_ARENA_BOT_TOKEN=rehearsal-token
AKUKI_ARENA_SESSION_COOKIE=rehearsal-cookie

# Akuki's real bot id, confirmed against GET /api/bots on 2026-09-07. Real on
# purpose: it is an identifier, not a secret, and using the live one means the
# rehearsal exercises the same self-skip path the live run will.
AKUKI_ARENA_BOT_ID=b80c722e-014f-407c-8738-fb175fa0bc1e

# Outside the tenant directory -- that directory has exactly one writer -- and
# ABSOLUTE. A relative path resolves against the CWD of whichever process started
# the connector: `npm start` gives connector/.akuki-arena/, the demo server gives
# borg/demo/server/.akuki-arena/. Two state databases for one rehearsal is the same
# class of confusion as two tenants.
AKUKI_ARENA_STATE_DB=/absolute/path/beside/the/tenant/copy/arena-state.db

AKUKI_ARENA_POLL_INTERVAL_MS=4000
AKUKI_ARENA_CATCH_UP_BACKLOG=0

# How far back a returning process still answers, in milliseconds. Unset means no
# window: an absence of any length is repaid message by message. 600000 is ten
# minutes -- long enough to cover a restart, short enough that a two-hour pause
# does not come back as two hours of late replies.
# AKUKI_ARENA_MAX_CATCH_UP_AGE_MS=600000

# --- the fake Arena's own settings, all optional -------------------------------
# AKUKI_FAKE_ARENA_PORT=7750
# AKUKI_FAKE_ARENA_THREAD_ID=184888fd-3014-45f4-a1b3-cbbf327e54e0
# REQUIRED by the fake Arena: who a message typed into its page is from. Read it
# from GET /api/users and do not guess -- c8da0827 is Lunaria, a bot, and a rehearsal
# that used it built M4 trust rows about the wrong being.
AKUKI_FAKE_ARENA_HUMAN_ID=696dfd3a-1c4d-4eef-99fe-f9f3db31e5d1
# AKUKI_FAKE_ARENA_HUMAN_NAME=Zosia
# AKUKI_FAKE_ARENA_SEED=./seed.json

# --- needed only by a process that OPENS a Borg --------------------------------
# The fake Arena needs none of these, and neither does a dry run.
#
# Two names for one directory: AKUKI_DATA_DIR when the connector opens its own
# Borg, BORG_DATA_DIR when borg's demo server opens one (the plugin path). Unset,
# the demo server opens .borg-data/demo instead -- healthy, and a stranger.
# AKUKI_DATA_DIR=/path/to/a/COPY/of/the/tenant
# BORG_DATA_DIR=/path/to/a/COPY/of/the/tenant
# plus the fork's Anthropic-only block, five BORG_MODEL_* and four BORG_EMBEDDING_*
# -- see borg/AKUKI_ORACLE_SMOKE_TEST.md. Never point this at the live tenant for a
# rehearsal.
#
# Set these when the demo server hosts the connector, because it starts the
# maintenance and autonomy schedulers and their token budgets otherwise have no
# ceiling:
# BORG_MAINTENANCE_LIGHT_BUDGET=60000
# BORG_MAINTENANCE_HEAVY_BUDGET=200000
